@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
@* <h3>@ViewData["Title"]</h3> *@
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="mb-0 text-center"><i class="bi bi-shield-lock-fill me-2"></i>@ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <p>To use an authenticator app go through the following steps:</p>
                    <p>Scan the QR Code or enter this key <br /><kbd>@Model.SharedKey</kbd> into your two factor authenticator app.</p>

                            <div class="text-center mb-3">
                                <canvas id="qrCode"></canvas>
                                <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                            </div>

                            <p>
                                Once you have scanned the QR code or input the key, your 2FA app will give you a unique code.
                                Enter it below.
                            </p>

                            <div class="d-flex justify-content-center">
                                <div class="col-md-6">
                                    <form id="send-code" method="post">
                                        <div class="form-floating mb-3">
                                            <input asp-for="Input.Code" class="form-control text-center" autocomplete="off" placeholder="" />
                                            <label asp-for="Input.Code" class="control-label form-label">Verification Code</label>
                                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                                        </div>

                                        <button type="submit" class="w-100 btn btn-lg btn-primary">Verify</button>
                                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                    </form>
                                </div>
                            </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* <script type="text/javascript" src="~/lib/qrcode.js"></script>
    <script type="text/javascript" src="~/js/qr.js"></script> *@

    <!-- Include QR.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var qrCodeElement = document.getElementById("qrCode");
            var qrDataElement = document.getElementById("qrCodeData");

            if (!qrDataElement) {
                console.error("QR Code data element not found.");
                return;
            }

            var url = qrDataElement.getAttribute("data-url");

            if (!url) {
                console.error("QR Code URL is missing.");
                return;
            }

            // Create QR Code
            var qr = new QRious({
                element: qrCodeElement,
                value: url,
                size: 200
            });
        });
    </script>
}
