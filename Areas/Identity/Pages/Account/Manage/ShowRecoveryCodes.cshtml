@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body text-center p-4">
                    <h4 class="mb-3">
                        <i class="bi bi-shield-lock-fill me-2"></i>@ViewData["Title"]
                    </h4>

                    <!-- Improved Alert -->
                    <div class="alert alert-warning border-0 rounded-3 shadow-sm text-start" role="alert">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                            <div>
                                <strong class="d-block">Put these codes in a safe place.</strong>
                                <p class="mb-2">
                                    If you lose your device and these codes, you will lose access to your account.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Recovery Codes Grid -->
                    <div class="mt-4">
                        <div class="row g-2 text-center">
                            @for (var i = 0; i < Model.RecoveryCodes.Length; i++)
                            {
                                <div class="col-6">
                                    <div class="p-2 bg-light border rounded fw-semibold recovery-code">
                                        @Model.RecoveryCodes[i]
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <p class="text-muted mt-3">Save these codes securely. Each code can be used once.</p>

                </div>
            </div>

        </div>
    </div>
</div>
