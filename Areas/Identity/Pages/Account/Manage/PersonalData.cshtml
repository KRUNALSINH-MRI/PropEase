@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<!-- ✅ Bootstrap (only if not already in _Layout.cshtml) -->
@* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" /> *@

<div class="container mt-5 mb-5 d-flex justify-content-center align-items-center">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 600px; width: 100%;">
        <div class="card-body">
            <h3 class="text-center text-primary fw-bold mb-3">@ViewData["Title"]</h3>

            <p class="text-muted text-center mb-4">
                Your account contains personal data that you have provided to us.
                You can download or permanently delete this data below.
            </p>

            <div class="alert alert-warning text-center mb-4 rounded-3">
                <strong>⚠ Deleting this data will permanently remove your account.</strong><br />
                This action cannot be undone.
            </div>

            <!-- Download Data Form -->
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="text-center">
                <button class="btn btn-primary btn-lg rounded-3 shadow-sm px-4" type="submit">
                    ⬇ Download Personal Data
                </button>
            </form>

            <!-- Delete Account -->
            <div class="text-center mt-4">
                <a id="delete" asp-page="DeletePersonalData"
                   class="btn btn-danger btn-lg rounded-3 shadow-sm px-4">
                    🗑 Delete Account
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
