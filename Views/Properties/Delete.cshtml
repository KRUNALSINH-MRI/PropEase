@* @model PropEase.Models.Property

@{
    ViewData["Title"] = "Delete Property";
}
<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
            <h2 class="text-center mb-4 fw-bold text-primary">
                <i class="bi bi-house-door-fill me-2"></i>Delete Your Property
            </h2>
            <hr class="mb-4">

            <!-- Property Details -->
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Title)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Price)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Price)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.City)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.City)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ImageUrl)</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="img-thumbnail" style="max-width:300px;" />
                    }
                    else
                    {
                        <span>No image available</span>
                    }
                </dd>
            </dl>

            <!-- Delete Form -->
            <div class="d-flex justify-content-end gap-2 mt-3">
                <form id="deleteForm" asp-action="Delete">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">Back to List</a>
                    <input type="hidden" asp-for="Id" />

                    <!-- Delete Button triggers modal -->
                        <button type="button" class="btn btn-danger rounded-pill px-4 me-2 "
                                data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                            Delete
                        </button>
                   
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Modal moved OUTSIDE the form -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1"
     aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="fs-5 text-muted mb-3">Are you sure you want to delete this property?</p>
                <p class="text-danger fw-semibold">This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-danger px-4"
                        onclick="submitDeleteForm()">
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function submitDeleteForm() {
            // Close modal (optional)
            const modalElement = document.getElementById('confirmDeleteModal');
            const modalInstance = bootstrap.Modal.getInstance(modalElement)
                || new bootstrap.Modal(modalElement);
            modalInstance.hide();

            // Submit the form
            document.getElementById('deleteForm').submit();
        }
    </script>
} *@
