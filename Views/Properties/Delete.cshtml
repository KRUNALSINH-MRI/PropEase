@model PropEase.Models.Property

@{
    ViewData["Title"] = "Delete Property";
}

<h1>Delete Property</h1>

<h3>Are you sure you want to delete this property?</h3>
<div>
    <h4>Property Details</h4>
    <hr />
    <dl class="row">
        <!-- 1. Basic Details -->
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PropertyType)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PropertyType)</dd>

        <!-- 2. Location Info -->
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.City)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.State)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.State)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ZipCode)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ZipCode)</dd>

        <!-- 3. Specifications -->
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BHK)</dt>
        <dd class="col-sm-10">@((Model.BHK == 0) ? "1 RK" : $"{Model.BHK} BHK")</dd>


        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Area)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Area)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FurnishType)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FurnishType)</dd>

        <!-- 4. Pricing -->
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Price)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Type)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Type)</dd>

        <!-- 5. Media -->
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ImageUrl)</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Property Image" class="img-thumbnail" style="max-width:200px;" />
            }
            else
            {
                <span>No image available</span>
            }
        </dd>

        <!-- 6. Metadata -->
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OwnerId)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.OwnerId)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PostedOn)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PostedOn)</dd>
    </dl>
     
    <form id="deleteForm" asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <!-- Delete Button triggers the modal -->
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
            Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>

        <!-- Bootstrap Centered Modal -->
        <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <!-- This centers it vertically -->
                <div class="modal-content shadow-lg border-0 rounded-3">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p class="fs-5 text-muted mb-3">Are you sure you want to delete this property?</p>
                        <p class="text-danger fw-semibold">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

</div>
