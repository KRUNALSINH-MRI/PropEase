@model PropEase.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Property Image -->
        <div class="position-relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            { 
            <img src="@Model.ImageUrl"
                 class="w-100" alt="Property Image"
                 style="height:400px; object-fit:cover;">
            }
            else
            {

                <span>No image available</span>
            }

            <span class="position-absolute top-0 end-0 m-3 badge bg-primary rounded-pill px-3 py-2 shadow-sm fs-6">
                @Model.Type
            </span>
        </div>
       



        <div class="card-body p-4">
            <!-- Title & Location -->
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div>
                    <h2 class="fw-bold text-primary mb-2">@Model.Title</h2>
                    <p class="text-muted mb-1">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        @Model.Address, @Model.City, @Model.State - @Model.ZipCode
                    </p>
                    <p class="small text-muted">
                        Posted on <strong>@Model.PostedOn.ToString("dd MMM yyyy")</strong>
                    </p>
                </div>

                <div class="text-end">
                    <h4 class="text-success fw-bold mb-0">
                        ₹@Model.Price.ToString("N0")
                    </h4>
                    <span class="text-muted small">(@Model.Area sq.ft)</span>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Property Overview -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3">Property Overview</h5>
                        <ul class="list-unstyled mb-0">
                            <li><i class="bi bi-house-door-fill text-primary me-2"></i><strong>Type:</strong> @Model.PropertyType</li>
                            <li><i class="bi bi-building-fill text-primary me-2"></i><strong>BHK:</strong> @((Model.BHK == 0) ? "1 RK" : $"{Model.BHK} BHK")</li>
                            <li><i class="bi bi-cup-hot-fill text-primary me-2"></i><strong>Furnish Type:</strong> @Model.FurnishType</li>
                            <li><i class="bi bi-file-text-fill text-primary me-2"></i><strong>Description:</strong> @Model.Description</li>
                        </ul>
                    </div>
                </div>

                <!-- Owner Details -->
                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3">Owner Information</h5>
                        <ul class="list-unstyled mb-0">
                            <li><i class="bi bi-person-circle text-primary me-2"></i><strong>Owner:</strong> @(Model.Owner?.Email ?? "N/A")</li>
                            <li><i class="bi bi-telephone-fill text-primary me-2"></i><strong>Contact:</strong> Available on request</li>
                        </ul>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>

                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark rounded-pill px-4 me-2">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id"
                       class="btn btn-danger rounded-pill px-4"
                       onclick="return confirm('Are you sure you want to delete this property?');">
                        <i class="bi bi-trash3-fill me-1"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8fafc;
        padding: 20px;
    }

    .card {
        border-radius: 1rem;
    }

    .badge {
        font-size: 0.9rem;
    }

    h2, h4, h5 {
        letter-spacing: 0.3px;
    }

    ul li {
        margin-bottom: 6px;
        font-size: 0.95rem;
    }

    .btn-dark:hover {
        background: linear-gradient(to right, #007bff, #6610f2);
        color: white;
    }

    .btn-danger {
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #dc3545;
            color: white;
        }
</style>
