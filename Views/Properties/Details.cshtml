@model PropEase.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Property Image -->
        <div class="position-relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            { 
            <img src="@Model.ImageUrl"
                 class="w-100" alt="Property Image"
                 style="height:400px; object-fit:cover;">
            }
            else
            {

                <span>No image available</span>
            }

            <span class="position-absolute top-0 end-0 m-3 badge bg-primary rounded-pill px-3 py-2 shadow-sm fs-6">
                @Model.Type
            </span>
        </div>
       



        <div class="card-body p-4">
            <!-- Title & Location -->
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div>
                    <h2 class="fw-bold text-primary mb-2">@Model.Title</h2>
                    <p class="text-muted mb-1">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        @Model.Address, @Model.City, @Model.State - @Model.ZipCode
                    </p>
                    <p class="small text-muted">
                        Posted on <strong>@Model.PostedOn.ToString("dd MMM yyyy")</strong>
                    </p>
                </div>

                <div class="text-end">
                    <h4 class="text-success fw-bold mb-0">
                        ₹@Model.Price.ToString("N0")
                    </h4>
                    <span class="text-muted small">(@Model.Area sq.ft)</span>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Property Overview -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3">Property Overview</h5>
                        <ul class="list-unstyled mb-0">
                            <li><i class="bi bi-house-door-fill text-primary me-2"></i><strong>Type:</strong> @Model.PropertyType</li>
                            <li><i class="bi bi-building-fill text-primary me-2"></i><strong>BHK:</strong> @((Model.BHK == 0) ? "1 RK" : $"{Model.BHK} BHK")</li>
                            <li><i class="bi bi-cup-hot-fill text-primary me-2"></i><strong>Furnish Type:</strong> @Model.FurnishType</li>
                            <li><i class="bi bi-file-text-fill text-primary me-2"></i><strong>Description:</strong> @Model.Description</li>
                        </ul>
                    </div>
                </div>

                <!-- Owner Details -->
                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3">Owner Information</h5>
                        <ul class="list-unstyled mb-0">
                            <li><i class="bi bi-person-circle text-primary me-2"></i><strong>Owner:</strong> @(Model.Owner?.Email ?? "N/A")</li>
                            <li><i class="bi bi-telephone-fill text-primary me-2"></i><strong>Contact:</strong> Available on request</li>
                        </ul>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>

                <div>
                    @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                    {
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning rounded-pill px-4">Edit</a>

                            <!-- Delete Button (Triggers Modal) -->
                            <form id="deleteForm" asp-action="DeleteConfirmed" asp-route-id="@Model?.Id" method="post">
                                <button type="button" class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                                    Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ✅ Delete Confirmation Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1"
     aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="fs-5 text-muted mb-3">
                    Are you sure you want to delete <strong>@Model.Title</strong>?
                </p>
                <p class="text-danger fw-semibold">This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" onclick="submitDeleteForm()">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function submitDeleteForm() {
            const modalElement = document.getElementById('confirmDeleteModal');
            const modalInstance = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
            modalInstance.hide();
            document.getElementById('deleteForm').submit();
        }
    </script>
}


<style>
    body {
        background-color: #f8fafc;
        padding: 20px;
    }

    .card {
        border-radius: 1rem;
    }

    .badge {
        font-size: 0.9rem;
    }

    h2, h4, h5 {
        letter-spacing: 0.3px;
    }

    ul li {
        margin-bottom: 6px;
        font-size: 0.95rem;
    }

    .btn-dark:hover {
        background: linear-gradient(to right, #007bff, #6610f2);
        color: white;
    }

    .btn-danger {
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: black;
            color: white;
        }

    .btn-warning {
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            background-color: black;
            color: white;
        }
</style>
