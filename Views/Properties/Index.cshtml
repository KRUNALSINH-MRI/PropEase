@model IEnumerable<PropEase.Models.Property>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Properties";
    var currentUserId = UserManager.GetUserId(User);
}

<head>
    <link rel="stylesheet" href="~/css/IndexProperties.css" />
</head>

<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-center text-primary">Explore Properties</h2>

    @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
    {
        <div class="text-center mb-4">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                ➕ Add New Property
            </a>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card shadow-lg border-0 rounded-4 h-100 property-card">
                    <!-- Property Image -->
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top rounded-top-4"
                                 alt="Property Image" style="height:220px; object-fit:cover;">
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                        <span class="position-absolute top-0 end-0 m-2 badge bg-primary rounded-pill px-3 py-2">
                            @item.Type
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column justify-content-between">
                        <!-- Property Title & Basic Info -->
                        <div>
                            <h5 class="card-title fw-bold mb-1">@item.Title</h5>
                            <p class="text-muted mb-2 small">@item.Address, @item.City</p>

                            <div class="mb-2">
                                <span class="badge bg-secondary">@item.PropertyType</span>
                                <span class="badge bg-info text-dark">@item.FurnishType</span>
                                <span class="badge bg-success">@((item.BHK == 0) ? "1 RK" : $"{item.BHK} BHK")</span>
                            </div>

                            <p class="fw-semibold text-dark mb-0">
                                ₹@item.Price.ToString("N0")
                                <small class="text-muted">(@item.Area sq.ft)</small>
                            </p>

                            <p class="small text-muted mb-0">
                                Listed on: <strong>@item.PostedOn.ToString("dd-MMM-yyyy")</strong>
                            </p>
                            <p class="small text-muted mb-2">
                                Owner: @(item.Owner?.Email ?? "N/A")
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-primary rounded-pill px-3">
                                View Details
                            </a>

                            <div class="d-flex align-items-center gap-2">
                                @if (item.OwnerId == currentUserId)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-dark rounded-pill px-3">
                                        Edit
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm rounded-circle"
                                       title="Delete Property"
                                       onclick="return confirm('Are you sure you want to delete this property?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                }
                                else
                                {
                                    <form asp-controller="Favorites" asp-action="ToggleFavorite" method="post" class="m-0">
                                        <input type="hidden" name="propertyId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            ❤️ Add to Favorites
                                        </button>
                                    </form>

                                    <a asp-controller="Messages" asp-action="ContactOwner" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-success rounded-pill px-3">
                                        📩 Contact
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
