@model IEnumerable<PropEase.Models.Property>

@{
    ViewData["Title"] = "Properties";
}

<h1>Properties</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Owner"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Property</a>
    </p>
}


<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.PropertyType)</th>
            <th>Location</th>
            <th>@Html.DisplayNameFor(model => model.BHK)</th>
            <th>@Html.DisplayNameFor(model => model.Area)</th>
            <th>@Html.DisplayNameFor(model => model.FurnishType)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.Type)</th>
            <th>@Html.DisplayNameFor(model => model.ImageUrl)</th>
            <th>@Html.DisplayNameFor(model => model.PostedOn)</th>
            <th>@Html.DisplayNameFor(model => model.OwnerId)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.PropertyType)</td>

                <!-- Combined Location -->
                <td>@($"{item.Address}, {item.City}, {item.State} - {item.ZipCode}")</td>

                <td>@((item.BHK == 0) ? "1 RK" : $"{item.BHK} BHK")</td>

                <td>@Html.DisplayFor(modelItem => item.Area)</td>
                <td>@Html.DisplayFor(modelItem => item.FurnishType)</td>

                <!-- Price formatted as currency -->
                <td>@item.Price.ToString("C")</td>

                <td>@Html.DisplayFor(modelItem => item.Type)</td>

                <!-- Image preview -->
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="Property Image" width="100" height="80" style="object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>

                <td>@item.PostedOn.ToString("dd-MMM-yyyy")</td>
                <td>@(item.Owner?.Email ?? "N/A")</td>


                @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> | 
                        <form asp-controller="Favorites" asp-action="ToggleFavorite" method="post" class="mt-2">
                            <input type="hidden" name="propertyId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                ❤️ Add to Favorites
                            </button>
                        </form>
                        <a asp-controller="Messages" asp-action="ContactOwner" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-success ms-1">
                            📩 Contact
                        </a>
                    </td>
                }
                else
                {
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <form asp-controller="Favorites" asp-action="ToggleFavorite" method="post" class="mt-2">
                            <input type="hidden" name="propertyId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                ❤️ Add to Favorites
                            </button>
                        </form>
                        <a asp-controller="Messages" asp-action="ContactOwner" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-success ms-1">
                            📩 Contact
                        </a>
                    </td>
                }
                <!-- Favorite button visible to everyone -->
                

            </tr>
        }
    </tbody>
</table>
