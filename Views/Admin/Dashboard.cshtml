@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">🧭 Admin Dashboard</h2>

    <!-- Overview Cards -->
    <div class="row text-center mb-4">

        <div class="col-md-3">
            <div class="card p-3 shadow-sm dashboard-card" onclick="toggleSection('users')">
                <h5>Total Users</h5>
                <h3>@ViewBag.TotalUsers</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm dashboard-card" onclick="toggleSection('properties')">
                <h5>Total Properties</h5>
                <h3>@ViewBag.TotalProperties</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm dashboard-card" onclick="toggleSection('owners')">
                <h5>Owners</h5>
                <h3>@ViewBag.TotalOwners</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm dashboard-card" onclick="toggleSection('messages')">
                <h5>Messages</h5>
                <h3>@ViewBag.TotalMessages</h3>
            </div>
        </div>

    </div>

    <div id="users-section" class="toggle-section" style="display:none;">
        <h4>All Users</h4>
        <table class="table table-bordered">
            <thead class="table-secondary">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody id="users-table"></tbody>
        </table>
    </div>

    <div id="owners-section" class="toggle-section" style="display:none;">
        <h4>All Owners</h4>
        <table class="table table-bordered">
            <thead class="table-secondary">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody id="owners-table"></tbody>
        </table>
    </div>

    <div id="properties-section" class="toggle-section" style="display:none;">
        <h4>All Properties</h4>
        <table class="table table-bordered">
            <thead class="table-secondary">
                <tr>
                    <th>Title</th>
                    <th>Owner</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody id="properties-table"></tbody>
        </table>
    </div>

    <div id="messages-section" class="toggle-section" style="display:none;">
        <h4>All Messages</h4>
        <table class="table table-bordered">
            <thead class="table-secondary">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Received At</th>
                </tr>
            </thead>
            <tbody id="messages-table"></tbody>
        </table>
    </div>



    <!-- Recent Properties -->
    <div class="mt-4">
        <h4>Recent Properties</h4>
        <table class="table table-bordered">
            <thead class="table-secondary">
                <tr>
                    <th>Title</th>
                    <th>Owner</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prop in ViewBag.RecentProperties)
                {
                    <tr>
                        <td>@prop.Title</td>
                        <td>@(prop.Owner != null ? prop.Owner.FullName ?? prop.Owner.Email : "N/A")</td>
                        <td>@prop.PostedOn.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Recent Messages -->
    <div class="mt-5">
        <h4>Recent Contact Messages</h4>
        <table class="table table-bordered">
            <thead class="table-secondary">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Received At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var msg in ViewBag.RecentMessages)
                {
                    <tr>
                        <td>@msg.Name</td>
                        <td>@msg.Email</td>
                        <td>@msg.Subject</td>
                        <td>@msg.CreatedAt.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>

    function toggleSection(type) {

        const sectionId = type + "-section";
        const section = document.getElementById(sectionId);

        // Toggle visibility
        if (section.style.display === "none") {
            section.style.display = "block";
            loadData(type);
        } else {
            section.style.display = "none";
        }
    }

    function loadData(type) {
        fetch(`/Admin/Get${capitalize(type)}`)
            .then(res => res.json())
            .then(data => {
                let tableId = type + "-table";
                let tbody = document.getElementById(tableId);
                tbody.innerHTML = "";

                data.forEach(item => {
                    let row = "<tr>";

                    Object.values(item).forEach(v => {
                        row += `<td>${v}</td>`;
                    });

                    row += "</tr>";
                    tbody.innerHTML += row;
                });
            });
    }

    function capitalize(str) {
        return str.charAt(0).toUpperCase() + str.slice(1);
    }

</script>

