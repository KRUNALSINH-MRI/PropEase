<!-- Optional: JS Validation -->
<script>
    document.querySelector('form[role="search"]').addEventListener('submit', function (e) {
        const min = parseFloat(this.querySelector('[name="minPrice"]').value) || 0;
        const max = parseFloat(this.querySelector('[name="maxPrice"]').value) || 0;
        if (min && max && min > max) {
            e.preventDefault();
            alert('Minimum price cannot be greater than Maximum price.');
        }
    });
</script>




