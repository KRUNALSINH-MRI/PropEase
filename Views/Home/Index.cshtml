<!-- 🏡 HERO SECTION -->
<section class="hero-section text-white text-center d-flex align-items-center justify-content-center">
    <div class="container">
        <h1 class="hero-title">Find Your Perfect Home with Ease</h1>
        <p class="hero-subtitle">Explore thousands of verified listings for rent, sale, or purchase — all in one place.</p>

        <!-- 🔍 Search Bar -->
        <div class="search-box d-flex flex-wrap justify-content-center">
            <select class="form-select city-select m-2">
                <option selected disabled>Select City</option>
                <option>Ahmedabad</option>
                <option>Bangalore</option>
                <option>Delhi</option>
                <option>Hyderabad</option>
                <option>Mumbai</option>
                <option>Pune</option>
                <option>Vadodara</option>
                
                
                
            </select>

            <select class="form-select type-select m-2">
