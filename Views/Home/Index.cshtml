<!-- 🏡 HERO SECTION -->
<section class="hero-section text-white text-center d-flex align-items-center justify-content-center">
    <div class="container">
        <h1 class="hero-title mb-3">Find Your Perfect Home with Ease</h1>
        <p class="hero-subtitle mb-4">
            Explore thousands of verified listings for rent, sale, or purchase — all in one place.
        </p>

        <!-- 🔍 Search & Filter Form -->
        <form asp-controller="Properties" asp-action="Index" method="get" class="search-box d-flex flex-wrap justify-content-center align-items-center" role="search">

            <!-- City Dropdown -->
            <select name="city" class="form-select city-select m-2" aria-label="Select city">
                <option value="">All Cities</option>
                @foreach (var c in ViewBag.Cities as List<string> ?? new List<string> { "Ahmedabad", "Bangalore", "Delhi", "Hyderabad", "Mumbai", "Pune", "Vadodara" })
                {
                    if (ViewBag.CurrentCity == c)
                    {
                        <option value="@c" selected="selected">@c</option>
                    }
                    else
                    {
                        <option value="@c">@c</option>
                    }
                }
            </select>

            <!-- Property Type Dropdown -->
            <select name="type" class="form-select type-select m-2" aria-label="Select property type">
                <option value="">All Types</option>
                @foreach (var t in ViewBag.Types as List<string> ?? new List<string> { "Independent House", "Apartment", "Duplex", "Farm House", "Villa" })
                {
                    if (ViewBag.CurrentType == t)
                    {
                        <option value="@t" selected="selected">@t</option>
                    }
                    else
                    {
                        <option value="@t">@t</option>
                    }
                }
            </select>

            <!-- Text Search -->
            <input type="text"
                   name="search"
                   class="form-control search-input m-2"
                   placeholder="Search by title, address or city"
                   value="@(ViewBag.CurrentSearch ?? String.Empty)"
                   aria-label="Search by title or address" />

            <!-- Price Range -->
            <input type="number"
                   name="minPrice"
                   class="form-control m-2"
                   placeholder="Min Price"
                   min="0"
                   step="0.01"
                   value="@(ViewBag.CurrentMinPrice?.ToString() ?? String.Empty)"
                   aria-label="Minimum price" />

            <input type="number"
                   name="maxPrice"
                   class="form-control m-2"
                   placeholder="Max Price"
                   min="0"
                   step="0.01"
                   value="@(ViewBag.CurrentMaxPrice?.ToString() ?? String.Empty)"
                   aria-label="Maximum price" />

            <!-- Buttons -->
            <button type="submit" class="btn btn-primary btn-search m-2">Search</button>

            <!-- ✅ Reset Button (clears all filters & reloads current page) -->
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light m-2" id="resetBtn">Reset</a>
        </form>
    </div>
</section>

