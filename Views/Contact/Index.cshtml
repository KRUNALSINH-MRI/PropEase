@model PropEase.Models.ContactMessage;
@{
    ViewData["Title"] = "Contact Us";
}
<link rel="stylesheet" href="~/css/contact_index.css" />

<div class="contact-section">
    <div class="container">
        <h2>Contact Us</h2>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success text-center">@ViewBag.Success</div>
        }

        <form asp-action="Index" asp-controller="Contact" method="post" class="contact-form">
            <div class="form-group mb-3">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter your name here"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email here" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Subject"></label>
                <input asp-for="Subject" class="form-control" placeholder="Enter the subject here" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Message"></label>
                <textarea asp-for="Message" class="form-control" rows="5" placeholder="Enter your message here"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Send Message</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

