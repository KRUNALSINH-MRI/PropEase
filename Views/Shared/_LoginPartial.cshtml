@using Microsoft.AspNetCore.Identity
@using PropEase.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        // Get the logged-in user
        var currentUser = await UserManager.GetUserAsync(User);
        var roles = await UserManager.GetRolesAsync(currentUser);

        // Extract first name safely
        var firstName = currentUser?.FullName?.Split(' ')[0] ?? "User";

        // ✅ Only show "Post Property" if user is Owner or Admin
        if (roles.Contains("Owner") || roles.Contains("Admin"))
        {
            <li class="nav-item">
                <a class="btn btn-post-property" asp-controller="Properties" asp-action="Create">
                    + <span>Post Property</span>
                </a>
            </li>
        }

        <li class="nav-item d-flex align-items-center">
            <a id="manage" class="nav-link text-white px-2"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Manage"
               style="white-space: nowrap;">
                Hello @firstName!
            </a>
        </li>


        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-white border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <!-- Optional: Show Post Property button to guests (redirects to login) -->
        <li class="nav-item">
            <a class="btn btn-post-property" asp-area="Identity" asp-page="/Account/Login">
                + <span>Post Property</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-white" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-white" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
